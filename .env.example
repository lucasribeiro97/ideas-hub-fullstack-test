# Copie para .env na raiz do repositório e preencha os valores.
#   cp .env.example .env
#
# Backend e frontend leem deste mesmo arquivo: a API via `node --env-file`, o
# Vite via `envDir` apontado para a raiz.
#
# O .env está no .gitignore desde o commit inicial — nenhum valor real deve ser
# versionado.

# ----------------------------------------------------------------------------
# PostgreSQL (consumido pelo docker-compose.yml)
# ----------------------------------------------------------------------------
POSTGRES_USER=ideas_hub
POSTGRES_PASSWORD=ideas_hub_dev
POSTGRES_DB=ideas_hub
POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# API
# ----------------------------------------------------------------------------
# NODE_ENV não mora aqui de propósito.
#
# Este arquivo é lido pelos dois lados: a API via `node --env-file` e o Vite via
# `envDir`. E o Vite respeita um `NODE_ENV` vindo de arquivo `.env` — com
# `NODE_ENV=development` aqui, `npm run build` gerava um pacote com o React de
# desenvolvimento: 920 KB em vez de 672 KB, com as verificações de dev ativas em
# produção. O `StrictMode` continuava montando cada tela duas vezes no pacote
# publicado, o que era visível como uma requisição cancelada por tela.
#
# NODE_ENV pertence ao processo, não a um arquivo de configuração compartilhado.
# A API assume `development` quando ela não existe (`src/lib/env.ts`), e quem
# publicar define a variável no ambiente de execução.
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Tempo máximo de uma consulta da API, em milissegundos. Existe para que nenhuma
# requisição possa monopolizar uma das conexões do pool indefinidamente. O script
# de importação não usa este valor: o merge dele leva dezenas de minutos.
DB_STATEMENT_TIMEOUT_MS=10000

# Precisa refletir as credenciais acima.
DATABASE_URL=postgres://ideas_hub:ideas_hub_dev@localhost:5432/ideas_hub

# Origem autorizada a chamar a API pelo navegador.
CORS_ORIGIN=http://localhost:5173

# ----------------------------------------------------------------------------
# Integração climática
# ----------------------------------------------------------------------------
# Chave gratuita em https://www.weatherapi.com/ — nunca versione o valor real.
# Ela é usada apenas no servidor; o navegador jamais a recebe.
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.weatherapi.com/v1

# Expiração do cache de clima, em segundos (padrão 600 = 10 minutos).
WEATHER_CACHE_TTL_SECONDS=600

# Tempo limite da chamada ao serviço externo, em milissegundos.
WEATHER_TIMEOUT_MS=5000

# ----------------------------------------------------------------------------
# Frontend
# ----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000
